{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../build.ps1",
                "-Project",
                "${workspaceFolderBasename}",
                "-Configuration",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile",
            "osx": {
                "command": "${workspaceFolder}/../build.sh",
                "args": [
                    "${workspaceFolderBasename}",
                    "Debug"
                ],
                "problemMatcher": "$gcc"
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../build.ps1",
                "-Project",
                "${workspaceFolderBasename}",
                "-Configuration",
                "Release"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$msCompile",
            "osx": {
                "command": "${workspaceFolder}/../build.sh",
                "args": [
                    "${workspaceFolderBasename}",
                    "Release"
                ],
                "problemMatcher": "$gcc"
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../build.ps1",
                "-Project",
                "${workspaceFolderBasename}",
                "-Target",
                "clean"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [],
            "osx": {
                "command": "${workspaceFolder}/../build.sh",
                "args": [
                    "${workspaceFolderBasename}",
                    "Debug",
                    "clean"
                ]
            }
        }
    ]
}